{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation manifest",
  "description": "Schema for .claude/validation.json. The manifest records validation commands only. Which technologies a boundary uses is determined from the repository, and the matching stack overlay skill is loaded when one exists.",
  "type": "object",
  "required": [
    "boundaries"
  ],
  "additionalProperties": true,
  "properties": {
    "description": {
      "type": "string"
    },
    "unmappedPathPolicy": {
      "type": "string"
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "paths",
          "commands"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique boundary identifier."
          },
          "description": {
            "type": "string",
            "description": "Responsibility of the boundary, stated without naming a technology."
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Glob patterns of changed paths that map to this boundary."
          },
          "workingDirectory": {
            "type": "string",
            "description": "Directory the commands must run from, relative to the repository root."
          },
          "note": {
            "type": "string"
          },
          "commands": {
            "type": "array",
            "description": "Validation commands that already exist for this boundary. An empty array means no executable validation is defined.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "run",
                "scope"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "run": {
                  "type": "string",
                  "description": "The exact existing command. Never invent a replacement."
                },
                "scope": {
                  "type": "string",
                  "description": "What the command actually verifies."
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Conditions that must hold for the command to execute. A missing prerequisite yields BLOCKED, never FAIL and never PASS."
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "commands": {
                  "minItems": 1
                }
              },
              "required": [
                "commands"
              ]
            },
            "then": {
              "required": [
                "workingDirectory"
              ],
              "description": "A boundary that declares commands must declare the directory they run from."
            }
          }
        ]
      }
    }
  }
}
